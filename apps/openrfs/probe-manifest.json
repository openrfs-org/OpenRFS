{
  "name": "OpenRFS Namespace Probe",
  "identifier": "RFSPROBE",
  "executable": "RFSPROBE.APP",
  "data_namespace": "RFSCLI",
  "memory_limit": 67108864,
  "max_handles": 4,
  "max_threads": 1,
  "capabilities": [
    "console",
    "data-read",
    "data-write"
  ],
  "arguments": ["--test-link-refusal"]
}
