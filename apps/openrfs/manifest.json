{
  "name": "OpenRFS Package Client",
  "identifier": "OPENRFS",
  "executable": "OPENRFS.APP",
  "data_namespace": "OPENRFS",
  "memory_limit": 67108864,
  "max_handles": 24,
  "max_threads": 1,
  "capabilities": [
    "console",
    "data-read",
    "data-write",
    "time",
    "entropy",
    "network",
    "packages"
  ],
  "arguments": ["install", "org.libsdl.chess"]
}
