{
  "name": "OpenGAT Package Repair",
  "identifier": "OPENGATR",
  "executable": "OPENGATR.APP",
  "data_namespace": "OPENGAT",
  "memory_limit": 67108864,
  "max_handles": 24,
  "max_threads": 1,
  "capabilities": [
    "console",
    "data-read",
    "data-write",
    "time",
    "entropy",
    "network",
    "packages"
  ],
  "arguments": ["repair"]
}
