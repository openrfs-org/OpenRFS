{
  "name": "OpenGAT Package Client",
  "identifier": "OPENGAT",
  "executable": "OPENGAT.APP",
  "data_namespace": "OPENGAT",
  "memory_limit": 67108864,
  "max_handles": 24,
  "max_threads": 1,
  "capabilities": [
    "console",
    "data-read",
    "data-write",
    "time",
    "entropy",
    "network",
    "packages"
  ],
  "arguments": ["install", "org.libsdl.chess"]
}
